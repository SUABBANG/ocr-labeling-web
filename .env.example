# 복사해서 .env 로 사용. (.env는 git에 커밋되지 않음)

# LLM 엔진
LLM_PROVIDER=claude          # claude | gpt
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-opus-4-8
# GPT_MODEL=gpt-4o

# 로컬 모델 경로 (기본값 사용 시 생략 가능)
# DET_MODEL_PATH=model/det/mobile_craft_large.aiocr_bpr.statedict.20251105.pth
# REC_MODEL_DIR=model/rec/20260708_printed_best_model
# REC_DEVICE=            # 인식 디바이스. 빈 값=자동(GPU 가능 시 GPU, 실패 시 CPU). 강제: cpu|gpu
# BOX_PAD_X=0.10         # 로컬 검출 박스 오른쪽 패딩(박스 높이 비율)
# BOX_PAD_Y=0.15         # 로컬 검출 박스 아래쪽 패딩(박스 높이 비율)
